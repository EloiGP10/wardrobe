# Supabase (Postgres)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGciOi...service-role-key
WARDROBE_STORAGE_BUCKET=wardrobe

# Optional: enable AI-powered import (otherwise the closet works without OpenAI)
# Without this key, import-via-OpenAI is disabled but the rest of the app works.
OPENAI_API_KEY=

# Server
PORT=3000